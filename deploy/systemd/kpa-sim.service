# kpa-sim: the Elecraft KPA1500 simulator with network PTT, as an always-on service.
# Install: see "Run as always-on services (Linux)" in the README.
# Replace YOUR_USER and /home/YOUR_USER/flex-sim with your own user and clone path.
#
# Ports: TCP+UDP 1500 (commands), UDP 1510 (RF sense), TCP 8737 (control page).

[Unit]
Description=kpa-sim - Elecraft KPA1500 simulator with network PTT and a T/R interlock bench
Documentation=https://github.com/nigelfenton/flex-sim#kpa1500-a-bench-for-network-ptt-and-tr-interlocks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/flex-sim
ExecStart=/usr/bin/python3 -u /home/YOUR_USER/flex-sim/kpa_sim.py --no-cli
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
