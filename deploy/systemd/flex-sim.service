# flex-sim: the synthetic FlexRadio, as an always-on service.
# Install: see "Run as always-on services (Linux)" in the README.
# Replace YOUR_USER and /home/YOUR_USER/flex-sim with your own user and clone path.
#
# Run this on a machine that is NOT running AetherSDR (see "Networking - the one
# rule" in the README): the sim answers discovery on :4992 as a real radio would.

[Unit]
Description=flex-sim - synthetic FlexRadio for AetherSDR
Documentation=https://github.com/nigelfenton/flex-sim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/flex-sim
# --pattern carrier gives a real S-meter reading and TX drive. To feed the
# KPA1500 sim the radio's TX edges, add:  --rf-sense 127.0.0.1:1510
ExecStart=/usr/bin/python3 -u /home/YOUR_USER/flex-sim/flex_sim.py --pattern carrier --ctl-port 8731
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
